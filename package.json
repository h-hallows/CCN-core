{
  "name": "@h-hallows/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-hallows/CCN-core.git"
  },
  "version": "0.1.6",
  "private": false,
  "type": "module",
  "description": "Owns the database: schema, migrations, the credential engine, business-day arithmetic and the copy-lint ruleset. No app, no routes.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./domain": "./src/domain/index.ts",
    "./db": "./src/db/index.ts",
    "./env": "./src/env.ts",
    "./lint": "./src/lint/forbidden.mjs",
    "./testing": "./src/testing/db.ts"
  },
  "bin": {
    "ccn-lint": "./src/lint/run.mjs"
  },
  "files": [
    "src",
    "migrations",
    "INVARIANTS.md"
  ],
  "scripts": {
    "db:migrate": "tsx src/db/migrate.ts",
    "db:deploy": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.36.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
